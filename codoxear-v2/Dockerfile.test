FROM node:22-bookworm
WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git ripgrep fd-find \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci && npx playwright install --with-deps chromium
RUN npm install --global @earendil-works/pi-coding-agent@1.0.0 @openai/codex@0.160.0 @anthropic-ai/claude-code@2.1.287
ENV PI_BIN=/usr/local/bin/pi CODEX_BIN=/usr/local/bin/codex CLAUDE_BIN=/usr/local/bin/claude
COPY . .
RUN npm run build
CMD ["node", "--import", "tsx", "scripts/verify-container.ts"]
