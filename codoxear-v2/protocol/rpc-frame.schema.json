{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocol": {
          "type": "number",
          "const": 1
        },
        "capabilities": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "required": [
        "type",
        "protocol",
        "capabilities"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "request"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "delegation-install"
                },
                "parentId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "localId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "grant": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 200
                },
                "expiresAt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "op",
                "parentId",
                "localId",
                "grant",
                "expiresAt"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "delegation-status"
                },
                "parentId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "localId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "op",
                "parentId",
                "localId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "delegation-revoke"
                },
                "parentId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "localId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "op",
                "parentId",
                "localId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "discover"
                },
                "actorId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                }
              },
              "required": [
                "op"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "workspace"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "remove": {
                  "type": "boolean"
                }
              },
              "required": [
                "op"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "resume-candidates"
                },
                "backend": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "pi",
                    "cc"
                  ]
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "op",
                "backend",
                "cwd"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "launch-status"
                },
                "agentId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                }
              },
              "required": [
                "op",
                "agentId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "create"
                },
                "agentId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "backend": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "pi",
                    "cc",
                    "fixture"
                  ]
                },
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "launch": {
                  "type": "object",
                  "properties": {
                    "provider_config": {
                      "type": "object",
                      "properties": {
                        "base_url": {
                          "type": "string",
                          "maxLength": 4096,
                          "format": "uri"
                        },
                        "api_key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8192,
                          "writeOnly": true
                        },
                        "api": {
                          "type": "string",
                          "enum": [
                            "openai-completions",
                            "openai-responses",
                            "anthropic-messages"
                          ]
                        },
                        "image_support": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "api_key"
                      ],
                      "additionalProperties": false
                    },
                    "env_vars": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "maxLength": 200,
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 8192
                      }
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "cwd": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "model": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "model_provider": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "preferred_auth_method": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "service_tier": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "reasoning_effort": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "resume_session_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 200
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "worktree_branch": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 200
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "create_in_tmux": {
                      "type": "boolean",
                      "const": false
                    }
                  }
                }
              },
              "required": [
                "op",
                "agentId",
                "backend",
                "name"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "messages"
                },
                "agentId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "localId": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "op",
                "agentId",
                "localId"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "send"
                },
                "agentId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "localId": {
                  "type": "string",
                  "maxLength": 200
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000
                }
              },
              "required": [
                "op",
                "agentId",
                "localId",
                "text"
              ]
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "interrupt"
                },
                "agentId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "localId": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "op",
                "agentId",
                "localId"
              ]
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "epoch",
        "operation"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "result"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "ok": {
          "type": "boolean"
        },
        "value": {},
        "error": {
          "type": "string",
          "maxLength": 1000
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "not_dispatched",
            "setup_required"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "epoch",
        "ok"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "protocol": {
          "type": "number",
          "const": 1
        },
        "capabilities": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "epoch",
        "protocol"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "notification"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "event": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "localId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "type": "string",
              "enum": [
                "completion",
                "attention"
              ]
            },
            "occurredAt": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "localId",
            "kind",
            "occurredAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "epoch",
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "notification.ack"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "type",
        "epoch",
        "id"
      ]
    }
  ]
}
