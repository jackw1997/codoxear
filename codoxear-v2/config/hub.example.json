{
  "independent": true,
  "origin": "https://hub.example.com",
  "hubId": "my-hub",
  "name": "My hub",
  "catalog": "./state/hub-catalog.sqlite",
  "database": "./state/hub-sessions.sqlite",
  "signingKey": "./state/hub-signing-key.json",
  "clientOrigins": [
    "https://client.example.com"
  ],
  "clients": [
    {
      "id": "codoxear-web",
      "redirectUris": [
        "https://client.example.com/auth-callback"
      ]
    }
  ],
  "listenHost": "127.0.0.1",
  "listenPort": 17430,
  "secureCookies": true,
  "setupToken": "REPLACE_WITH_A_RANDOM_ONE_TIME_SETUP_CODE_OF_AT_LEAST_32_CHARACTERS"
}
